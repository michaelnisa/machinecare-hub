VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Sentry error monitoring — leave blank to disable (dev/PR previews).
# Get the DSN from Sentry > Settings > Projects > <project> > Client Keys.
VITE_SENTRY_DSN=

# Optional: only needed for production builds to upload readable source maps.
# Sentry > Settings > Auth Tokens (needs project:releases scope).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
